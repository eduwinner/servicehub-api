# Todas as variáveis são opcionais: sem .env, o docker compose usa estes mesmos padrões.

# Banco de dados (PostgreSQL)
DB_NAME=nome da database
DB_USER=usuario
DB_PASS=senha
# Porta do Postgres no seu computador (dentro do Docker é sempre 5432)
DB_PORT=5433

# Porta da API no seu computador (a bancada de testes usa 8090)
API_PORT=8090

# Segurança: troque fora da sala de aula. Mínimo de 32 caracteres; sem ele a API não sobe.
JWT_SECRET=troque-por-um-segredo-proprio-com-32-caracteres-ou-mais
JWT_EXPIRATION_SECONDS=86400

# Primeiro ADMIN, criado no startup
SERVICEHUB_ADMIN_EMAIL=admin@servicehub.com
SERVICEHUB_ADMIN_PASSWORD=troque-esta-senha

# Origens do navegador liberadas (a bancada de testes roda em 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# pgAdmin (docker compose --profile tools up -d) em http://localhost:8091
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8091
# Credenciais do banco do aluno no servidor "Banco do aluno (localhost:5433)"
STUDENT_DB_USER=servicehub
STUDENT_DB_PASS=secret